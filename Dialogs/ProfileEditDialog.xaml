<Window x:Class="NaiwaProxy.Dialogs.ProfileEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑资料"
        Height="560" Width="480" MinHeight="520" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Panel3Brush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BFDBFE" Offset="0"/>
            <GradientStop Color="#60A5FA" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentPrimaryBorderBrush" Color="#93C5FD"/>
        <Geometry x:Key="IconUser">M20,21 A8,8 0 0 0 4,21 M16,7 A4,4 0 1 1 8,7 A4,4 0 0 1 16,7</Geometry>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Panel3Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="编辑资料" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border Width="96" Height="96" CornerRadius="48" Background="#F1F5F9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="AvatarPreviewImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                <Path x:Name="AvatarPlaceholderIcon" Data="{StaticResource IconUser}" Stretch="Uniform" Width="42" Height="42"
                                      Stroke="#94A3B8" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button x:Name="ChooseAvatarButton" Content="选择头像" Style="{StaticResource DarkButtonStyle}" Margin="0,12,0,0" MinWidth="120" Click="ChooseAvatarButton_Click"/>
                        <TextBlock Text="支持 JPG、PNG、WebP，最大 5MB" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock Text="邮箱" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="EmailText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="昵称" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="NicknameBox" MaxLength="50"/>
                    <TextBlock Text="修改昵称或选择头像后保存，可单独修改其中一项" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
