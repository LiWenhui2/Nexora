<Window x:Class="NaiwaProxy.Dialogs.ConfigurationBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置备份与恢复" Width="620" Height="360" MinWidth="560" MinHeight="330"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="104"/><Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/><Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBorderBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="配置备份与恢复" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="备份包含节点、订阅、路由规则和应用设置，系统最多保留最近 5 个自动备份。" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel>
                <TextBlock Text="备份状态" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="BackupStatusText" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="BackupPathText" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="OpenBackupButton" Content="打开备份" Style="{StaticResource DialogButtonStyle}" Margin="0" HorizontalAlignment="Left" Click="OpenBackupButton_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="恢复配置" Style="{StaticResource DialogButtonStyle}" Click="RestoreButton_Click"/>
                <Button Content="手动备份" Style="{StaticResource PrimaryDialogButtonStyle}" Click="BackupButton_Click"/>
                <Button Content="关闭" Style="{StaticResource DialogButtonStyle}" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
