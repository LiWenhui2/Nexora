<Window x:Class="NaiwaProxy.Dialogs.RequiredVersionUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本更新"
        Height="480" Width="520" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BFDBFE" Offset="0"/>
            <GradientStop Color="#60A5FA" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentPrimaryBorderBrush" Color="#93C5FD"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="20" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="↑" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="发现重要版本更新" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionLineText" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="LeadText" Grid.Row="1" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,14"/>

            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ReleaseTitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ReleaseContentText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="ProgressPanel" Grid.Row="3" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed"/>

            <Button x:Name="ActionButton" Grid.Row="4" Content="立即更新" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="ActionButton_Click"/>
        </Grid>
    </Border>
</Window>
