<Window x:Class="NaiwaProxy.Dialogs.DnsSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS 与 IPv6" Width="680" Height="500" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="104"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource Panel2Brush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}"><Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/><Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBorderBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock Text="DNS 与 IPv6" FontSize="21" FontWeight="Bold"/><TextBlock Text="配置国内 DNS、代理 DNS、DoH、IP 优先级与 IPv6 自动回退。" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="IP 模式" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="IpPreferenceCombo" Height="38"><ComboBoxItem Tag="Auto" Content="自动"/><ComboBoxItem Tag="IPv4Only" Content="仅 IPv4"/><ComboBoxItem Tag="PreferIPv4" Content="IPv4 优先"/><ComboBoxItem Tag="PreferIPv6" Content="IPv6 优先"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="国内 DNS" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="DomesticDnsTextBox" Height="38" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="代理 DNS" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="ProxyDnsTextBox" Height="38" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="连接选项" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="DnsOverHttpsToggle" Content="DoH" Margin="0,0,20,0"/><CheckBox x:Name="Ipv6FallbackToggle" Content="IPv6 自动回退"/></StackPanel></StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Text="DoH 会加密代理 DNS 查询；IPv6 不可用时，自动回退可避免连接长时间等待。" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="DnsTestButton" Content="DNS 泄漏测试" Style="{StaticResource DialogButtonStyle}" Margin="0" HorizontalAlignment="Left" Click="DnsTestButton_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Style="{StaticResource DialogButtonStyle}" IsCancel="True"/><Button Content="保存设置" Style="{StaticResource PrimaryDialogButtonStyle}" Click="SaveButton_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
