                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource NavChevronToggleStyle}" IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource NavGroupHeaderStyle}" Text="通知"/>
                            </Grid>
                        </ToggleButton>
                        <StackPanel x:Name="NotifyNavItems">
                        <Button x:Name="AnnouncementNavButton" Style="{StaticResource NavChildButtonStyle}" Click="AnnouncementNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="AnnouncementNavIcon" Style="{StaticResource NavTintedIconStyle}"/>
