                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource Panel2GlassBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
