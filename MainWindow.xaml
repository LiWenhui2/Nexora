                                        <TextBlock Text="通过邮箱验证码重置登录密码" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource AuthCloseButtonStyle}" Click="CloseAuthDialogButton_Click" ToolTip="关闭">
                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource AuthInputIconStyle}" Stroke="#64748B" Width="16" Height="16" Margin="0"/>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource AuthFieldLabelStyle}" Text="邮箱"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconMail}" Style="{StaticResource AuthInputIconStyle}"/>
                                    <TextBox x:Name="ForgotPasswordEmailBox" Grid.Column="1" Height="42"/>
                                </Grid>
                                <TextBlock Style="{StaticResource AuthFieldLabelStyle}" Text="邮箱验证码"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconKey}" Style="{StaticResource AuthInputIconStyle}"/>
                                    <TextBox x:Name="ForgotPasswordCodeBox" Grid.Column="1" Height="42" Margin="0,0,10,0"/>
                                    <Button x:Name="SendForgotPasswordCodeButton" Grid.Column="2" Content="发送验证码" Style="{StaticResource DarkButtonStyle}" MinWidth="120" Height="42" Click="SendForgotPasswordCodeButton_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource AuthFieldLabelStyle}" Text="新密码"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconLock}" Style="{StaticResource AuthInputIconStyle}"/>
                                    <PasswordBox x:Name="ForgotPasswordNewPasswordBox" Grid.Column="1" Style="{StaticResource FieldPasswordBoxStyle}" Height="42"/>
                                </Grid>
                                <TextBlock Style="{StaticResource AuthFieldLabelStyle}" Text="确认新密码"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconLock}" Style="{StaticResource AuthInputIconStyle}"/>
                                    <PasswordBox x:Name="ForgotPasswordConfirmPasswordBox" Grid.Column="1" Style="{StaticResource FieldPasswordBoxStyle}" Height="42"/>
                                </Grid>
                                <TextBlock Text="密码至少 6 位，且必须同时包含字母和数字" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="30,0,0,12"/>
                                <TextBlock x:Name="ForgotPasswordMessageText" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
                                <Button x:Name="ForgotPasswordSubmitButton" Content="确认重置" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="46" Margin="0,4,0,18" Click="ForgotPasswordSubmitButton_Click"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="想起密码了？" Foreground="{StaticResource MutedBrush}" FontSize="15" VerticalAlignment="Center"/>
                                    <Button Content="返回登录" Style="{StaticResource AuthLinkButtonStyle}" Margin="6,0,0,0" Click="GoToLoginPageButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="ChatToastPanel" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,32" Visibility="Collapsed" Panel.ZIndex="50" MaxWidth="360" Cursor="Hand" MouseLeftButtonUp="ChatToastPanel_MouseLeftButtonUp">
            <Border Background="{DynamicResource PanelGlassBrush}" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="14" Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="6" Opacity="0.18"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="管" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ChatToastTitleText" Text="管理员新消息" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ChatToastBodyText" Foreground="{StaticResource MutedBrush}" FontSize="13" TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AuthCloseButtonStyle}" Width="28" Height="28" Margin="10,0,0,0" Click="ChatToastCloseButton_Click" ToolTip="关闭">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource AuthInputIconStyle}" Stroke="#94A3B8" Width="12" Height="12" Margin="0"/>
                    </Button>
                </Grid>
            </Border>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ChatToastTransform" X="-380"/>
            </Border.RenderTransform>
        </Border>

        <Grid x:Name="BusyOperationOverlay" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="200" Background="#990F172A" Visibility="Collapsed" IsHitTestVisible="True">
            <Border x:Name="BusyOperationCard" Width="420" MaxWidth="520" Padding="28" CornerRadius="18" Background="{DynamicResource PanelGlassBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.28"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BusyOperationCardScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="4"/>
                        <Path Data="M19,3 A16,16 0 0 1 35,19" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.85"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="BusyOperationTitleText" Text="正在处理" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BusyOperationDetailText" Text="请稍候，操作完成前暂时无法使用软件。" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
