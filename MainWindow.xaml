                            </StackPanel>
                        </Button>
                        <Button x:Name="ContactAdminNavButton" Style="{StaticResource NavChildButtonStyle}" Click="ContactAdminNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="ContactAdminNavIcon" Style="{StaticResource NavTintedIconStyle}"/>
                                <TextBlock Text="管理员消息" VerticalAlignment="Center"/>
                                <Border x:Name="ContactAdminUnreadBadge" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="999" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="ContactAdminUnreadBadgeText" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button x:Name="VersionUpdateNavButton" Style="{StaticResource NavChildButtonStyle}" Click="VersionUpdateNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavLineIconStyle}" Data="{StaticResource IconRefresh}"/>
                                <TextBlock Text="版本更新" VerticalAlignment="Center"/>
                                <Border x:Name="VersionUpdateNavBadge" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="999" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="可更新" Foreground="#B45309" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        </StackPanel>

                        <ToggleButton x:Name="SystemGroupToggle" Style="{StaticResource NavGroupHeaderToggleStyle}" Tag="SystemNavItems" Click="NavGroupToggle_Click">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource NavChevronToggleStyle}" IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource NavGroupHeaderStyle}" Text="系统"/>
                            </Grid>
                        </ToggleButton>
                        <StackPanel x:Name="SystemNavItems">
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavChildButtonStyle}" Click="SettingsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavLineIconStyle}" Data="{StaticResource IconSettings}"/>
                                <TextBlock Text="设置"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LogNavButton" Style="{StaticResource NavChildButtonStyle}" Click="LogNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavLineIconStyle}" Data="{StaticResource IconLog}"/>
                                <TextBlock Text="日志"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AboutNavButton" Style="{StaticResource NavChildButtonStyle}" Click="AboutNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavLineIconStyle}" Data="{StaticResource IconAbout}"/>
                                <TextBlock Text="关于"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavChildButtonStyle}" Click="GithubNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavFillIconStyle}" Data="{StaticResource IconGitHub}"/>
                                <TextBlock Text="GitHub"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="3" Margin="12,0,12,14">
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <Border x:Name="SideUserArea"
                            HorizontalAlignment="Left"
                            Padding="4,6"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonUp="SideUserArea_Click">
                        <Border.ContextMenu>
                            <ContextMenu x:Name="SideUserContextMenu"
                                         Style="{StaticResource ChatContextMenuStyle}"
                                         Placement="Top"
                                         VerticalOffset="-4">
                                <MenuItem x:Name="SideMenuEditProfile" Header="修改个人信息" Foreground="{DynamicResource TextBrush}" Style="{StaticResource ChatContextMenuItemStyle}" Click="SideEditProfileButton_Click"/>
                                <MenuItem x:Name="SideMenuLogout" Header="退出登录" Style="{StaticResource SideMenuLogoutItemStyle}" Click="SideLogoutButton_Click"/>
                                <MenuItem x:Name="SideMenuLogin" Header="登录 / 注册" Style="{StaticResource ChatContextMenuItemStyle}" Click="SideLoginButton_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <StackPanel x:Name="AuthGuestPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource NavLineIconStyle}" Data="{StaticResource IconUser}" Stroke="#B45309" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="登录 / 注册" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="AuthUserPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Panel2GlassBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="SideAuthAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        <Path x:Name="SideAuthAvatarPlaceholder" Style="{StaticResource NavLineIconStyle}" Data="{StaticResource IconUser}" Stroke="#16A34A" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="180">
                                    <TextBlock x:Name="SideAuthNicknameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SideAuthEmailText" Foreground="{DynamicResource SideEmailForegroundBrush}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="MainHeaderBorder" Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" PreviewMouseWheel="NodePageChild_PreviewMouseWheel" SizeChanged="MainHeaderBorder_SizeChanged">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProxyToggleBorder" Style="{StaticResource ControlFieldBorderStyle}" BorderBrush="{StaticResource LineBrush}" Padding="14,0" MinWidth="200" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="启用代理" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,10,0"/>
                            <CheckBox x:Name="ProxyToggle" Style="{StaticResource ToggleSwitchStyle}" Checked="ProxyToggle_Changed" Unchecked="ProxyToggle_Changed"/>
                            <TextBlock x:Name="ProxyStateText" Text="运行中" Foreground="{StaticResource GreenBrush}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="NodePickerCombo" Grid.Column="1" Width="1" Height="1" Opacity="0" Visibility="Collapsed"
                              DisplayMemberPath="PickerDisplay" SelectionChanged="NodePickerCombo_SelectionChanged"/>
                    <Border x:Name="NodeInfoBorder" Grid.Column="1" MinHeight="42" Padding="12,0" CornerRadius="11" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="12,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="NodeSummaryText" Text="[VMess] -" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                            <StackPanel x:Name="NodeEndpointPanel" Orientation="Horizontal" Visibility="Visible">
                                <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="NodeEndpointText" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="CurrentTcpLatencyText" Text="&#160;" MinWidth="72" TextAlignment="Right" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                            <Border x:Name="NodeAvailabilityTag" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="NodeAvailabilityText" Text="待测速" Foreground="#166534" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="TrafficStatsPanel" Grid.Column="2" VerticalAlignment="Center">
                        <WrapPanel HorizontalAlignment="Right">
                            <Border Style="{StaticResource TrafficStatChipStyle}" Background="#DCFCE7" BorderBrush="#86EFAC">
                                <StackPanel>
                                    <TextBlock Text="下行" FontSize="11" Foreground="#166534"/>
                                    <TextBlock x:Name="TrafficDownSpeedText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#166534"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TrafficStatChipStyle}" Background="#DBEAFE" BorderBrush="#93C5FD">
                                <StackPanel>
                                    <TextBlock Text="上传" FontSize="11" Foreground="#1D4ED8"/>
                                    <TextBlock x:Name="TrafficUpSpeedText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TrafficStatChipStyle}" Background="#FEF3C7" BorderBrush="#FCD34D">
                                <StackPanel>
                                    <TextBlock Text="今日" FontSize="11" Foreground="#B45309"/>
                                    <TextBlock x:Name="TrafficTodayText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TrafficStatChipStyle}" Background="#EDE9FE" BorderBrush="#C4B5FD">
                                <StackPanel>
                                    <TextBlock Text="累计" FontSize="11" Foreground="#5B21B6"/>
                                    <TextBlock x:Name="TrafficTotalText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#5B21B6"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="NodePageScroll" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="NodeListScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="NodePageScroll_PreviewMouseWheel">
                <StackPanel Margin="24,20,24,16">
                    <!-- Node list module -->
                    <Border Style="{StaticResource FlatPanelStyle}" Background="{DynamicResource NodePagePanelBrush}" Margin="0" Padding="16">
                        <StackPanel>
                            <!-- Status bar -->
                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="TestCurrentLatencyButton" Content="测试选中" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,8" Click="TestCurrentLatencyButton_Click"/>
                                <Button x:Name="TestAllLatencyButton" Content="全部测试" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,8" Click="TestAllLatencyButton_Click"/>
                                <Button Content="健康检测" ToolTip="检测所选节点的 TCP、代理握手、网站访问、稳定性；活动节点额外测试下载速度" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,8" Click="NodeHealthCheckButton_Click"/>
                                <Button x:Name="RemoveUnavailableButton" Content="移除不可用" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,8" Click="RemoveUnavailableButton_Click"/>
                                <Button x:Name="RemoveDuplicateButton" Content="去除重复" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,8" Click="RemoveDuplicateButton_Click"/>
                                <Button x:Name="SyncCloudSubscriptionsButton" ToolTip="从云端更新当前账号下的全部节点" Style="{StaticResource DarkButtonStyle}" Margin="0,0,0,8" Visibility="Collapsed" Click="SyncCloudSubscriptionsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconRefresh}" Margin="0,0,6,0"/>
                                        <TextBlock Text="更新" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Table -->
                            <Border Background="{DynamicResource NodeTableBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="0">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource NodeContextMenuStyle}">
                                        <MenuItem Header="新建节点" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxNewNode_Click"/>
                                        <MenuItem Header="导入节点…" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxImportNode_Click"/>
                                        <MenuItem Header="导出节点…" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxExportNode_Click"/>
                                        <Separator Style="{StaticResource NodeContextSeparatorStyle}"/>
                                        <MenuItem Header="全部 TCP 测速" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxAllTcpTest_Click"/>
                                        <Separator Style="{StaticResource NodeContextSeparatorStyle}"/>
                                        <MenuItem Header="移除不可用节点" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxRemoveUnavailableNodes_Click"/>
                                        <MenuItem Header="去除重复节点" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxRemoveDuplicateNodes_Click"/>
                                        <MenuItem Header="节点维护…" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxMaintainNode_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Margin="14,14,14,6" VerticalAlignment="Center">
                                        <ComboBox x:Name="RegionFilterCombo" Style="{StaticResource FilterComboStyle}" SelectionChanged="FilterChanged">
                                            <ComboBoxItem Content="地区：全部" IsSelected="True"/>
                                        </ComboBox>
                                        <ComboBox x:Name="ProtocolFilterCombo" Style="{StaticResource FilterComboStyle}" SelectionChanged="FilterChanged">
                                            <ComboBoxItem Content="协议：全部" IsSelected="True"/>
                                            <ComboBoxItem Content="协议：VMess"/>
                                            <ComboBoxItem Content="协议：VLESS"/>
                                            <ComboBoxItem Content="协议：Trojan"/>
                                            <ComboBoxItem Content="协议：Shadowsocks"/>
                                            <ComboBoxItem Content="协议：SOCKS"/>
                                            <ComboBoxItem Content="协议：HTTP"/>
                                        </ComboBox>
                                        <ComboBox x:Name="SubscriptionFilterCombo" Style="{StaticResource FilterComboStyle}" MinWidth="142" SelectionChanged="FilterChanged">
                                            <ComboBoxItem Content="来源：全部订阅" IsSelected="True"/>
                                        </ComboBox>
                                        <ComboBox x:Name="LatencyFilterCombo" Style="{StaticResource FilterComboStyle}" SelectionChanged="FilterChanged">
                                            <ComboBoxItem Content="延迟：全部" IsSelected="True"/>
                                            <ComboBoxItem Content="延迟：可用"/>
                                            <ComboBoxItem Content="延迟：超时"/>
                                        </ComboBox>
                                        <ComboBox x:Name="SortCombo" Style="{StaticResource FilterComboStyle}" SelectionChanged="FilterChanged">
                                            <ComboBoxItem Content="排序：默认" IsSelected="True"/>
                                            <ComboBoxItem Content="排序：延迟优先"/>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,8">
                                            <TextBlock Text="仅可用" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <CheckBox x:Name="AvailableOnlyCheck" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="AvailabilityFilterChanged" Unchecked="AvailabilityFilterChanged"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <DataGrid x:Name="ProfilesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True"
                                              EnableRowVirtualization="False" EnableColumnVirtualization="False"
                                              IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2"
                                              SelectionChanged="ProfilesGrid_SelectionChanged"
                                              PreviewKeyDown="ProfilesGrid_PreviewKeyDown"
                                              MinHeight="280" MaxHeight="360" HorizontalScrollBarVisibility="Auto"
                                              PreviewMouseRightButtonDown="ProfilesGrid_PreviewMouseRightButtonDown"
                                              PreviewMouseWheel="ProfilesGrid_PreviewMouseWheel"
                                              Margin="14,0,14,14">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu Style="{StaticResource NodeContextMenuStyle}" Opened="ProfilesContextMenu_Opened">
                                                <MenuItem Header="设为活动节点" Tag="SingleSelectionOnly" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxSetActiveNode_Click"/>
                                                <Separator Tag="SingleSelectionOnly" Style="{StaticResource NodeContextSeparatorStyle}"/>
                                                <MenuItem Header="编辑节点" Tag="SingleSelectionOnly" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxEditNode_Click"/>
                                                <Separator Tag="SingleSelectionOnly" Style="{StaticResource NodeContextSeparatorStyle}"/>
                                                <MenuItem Header="测速选中节点" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxTcpTest_Click"/>
                                                <MenuItem Header="复制选中节点链接" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxCopySelectedLinks_Click"/>
                                                <MenuItem Header="导出节点" Tag="SingleSelectionOnly" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxExportNode_Click"/>
                                                <Separator Style="{StaticResource NodeContextSeparatorStyle}"/>
                                                <MenuItem Header="移除不可用节点" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxRemoveUnavailableNodes_Click"/>
                                                <MenuItem Header="去除重复节点" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxRemoveDuplicateNodes_Click"/>
                                                <Separator Style="{StaticResource NodeContextSeparatorStyle}"/>
                                                <MenuItem Header="删除选中节点" Style="{StaticResource NodeContextMenuItemStyle}" Click="CtxDeleteNode_Click"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <Expander IsExpanded="True" Margin="0,4,0,0" Background="Transparent">
                                                                        <Expander.Template>
                                                                            <ControlTemplate TargetType="Expander">
                                                                                <StackPanel>
                                                                                    <ToggleButton x:Name="GroupToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{DynamicResource NodeGroupHeaderBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}">
                                                                                        <ToggleButton.Template>
                                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8">
                                                                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                                                </Border>
                                                                                            </ControlTemplate>
                                                                                        </ToggleButton.Template>
                                                                                        <ContentPresenter ContentSource="Header"/>
                                                                                    </ToggleButton>
                                                                                    <ContentPresenter x:Name="ExpandSite" ContentSource="Content"/>
                                                                                </StackPanel>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsExpanded" Value="False">
                                                                                        <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Expander.Template>
                                                                        <Expander.Header>
                                                                            <StackPanel Orientation="Horizontal" Tag="{Binding Name}" Background="Transparent">
                                                                                <StackPanel.ContextMenu>
                                                                                    <ContextMenu Style="{StaticResource NodeContextMenuStyle}" Opened="SubscriptionContextMenu_Opened">
                                                                                        <MenuItem Header="刷新订阅" Style="{StaticResource NodeContextMenuItemStyle}" Click="SubscriptionRefreshMenu_Click"/>
                                                                                        <Separator Style="{StaticResource NodeContextSeparatorStyle}"/>
                                                                                        <MenuItem Header="删除订阅" Tag="DeleteSubscription" Style="{StaticResource NodeContextMenuItemStyle}" Click="SubscriptionDeleteMenu_Click"/>
                                                                                        <Separator Style="{StaticResource NodeContextSeparatorStyle}"/>
                                                                                        <MenuItem Header="自动刷新" Style="{StaticResource NodeContextSubmenuItemStyle}">
                                                                                            <MenuItem Header="关闭" Style="{StaticResource NodeContextMenuItemStyle}" Click="SubscriptionAutoRefreshOff_Click"/>
                                                                                            <MenuItem Header="每 15 分钟" Tag="15" Style="{StaticResource NodeContextMenuItemStyle}" Click="SubscriptionAutoRefreshPreset_Click"/>
                                                                                            <MenuItem Header="每 30 分钟" Tag="30" Style="{StaticResource NodeContextMenuItemStyle}" Click="SubscriptionAutoRefreshPreset_Click"/>
                                                                                            <MenuItem Header="每 60 分钟" Tag="60" Style="{StaticResource NodeContextMenuItemStyle}" Click="SubscriptionAutoRefreshPreset_Click"/>
                                                                                            <MenuItem Header="自定义…" Style="{StaticResource NodeContextMenuItemStyle}" Click="SubscriptionAutoRefreshCustom_Click"/>
                                                                                        </MenuItem>
                                                                                    </ContextMenu>
                                                                                </StackPanel.ContextMenu>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="8,0,12,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding ItemCount, StringFormat=({0} 个节点)}" Foreground="{StaticResource MutedBrush}"/>
                                                                                <Button Content="刷新" Tag="{Binding Name}"
                                                                                        Click="SubscriptionGroupRefreshButton_Click">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                                                                                            <Setter Property="Height" Value="30"/>
                                                                                            <Setter Property="MinWidth" Value="56"/>
                                                                                            <Setter Property="Padding" Value="10,0"/>
                                                                                            <Setter Property="Margin" Value="12,0,0,0"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Name}" Value="本地">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Expander.Header>
                                                                        <ItemsPresenter Margin="0,10,0,0"/>
                                                                    </Expander>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="状态" Width="108">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="30">
                                                            <StackPanel x:Name="StatusPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="StatusText" Text="{Binding StatusDisplay}" Style="{StaticResource NodeStatusTextStyle}"/>
                                                            </StackPanel>
                                                            <Button x:Name="SetActiveButton" Content="设为活跃" Tag="{Binding}" Click="RowSetActiveNode_Click" Style="{StaticResource SetActiveNodeButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="过期">
                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource RedBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="超时">
                                                                <Setter TargetName="StatusDot" Property="Fill" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="当前">
                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="StatusPanel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="SetActiveButton" Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="名称" Width="74">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource NodeTableTextBrush}"
                                                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="协议" Binding="{Binding ProtocolDisplay}" Width="88">
