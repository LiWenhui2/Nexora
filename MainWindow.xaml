                                        <CheckBox x:Name="LogFilterInfo" Content="INFO" IsChecked="True" Margin="0,0,12,6" VerticalAlignment="Center" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                                        <CheckBox x:Name="LogFilterWarn" Content="WARN" IsChecked="True" Margin="0,0,12,6" VerticalAlignment="Center" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                                        <CheckBox x:Name="LogFilterError" Content="ERROR" IsChecked="True" Margin="0,0,12,6" VerticalAlignment="Center" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                                        <CheckBox x:Name="LogFilterCrash" Content="CRASH" IsChecked="True" Margin="0,0,12,6" VerticalAlignment="Center" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                                    </WrapPanel>
